@model MusicRepository.Models.Music
@using MusicRepository.Models
@{
    ViewData["Title"] = "Añadir Música";
}
<h2>Añadir música</h2>
@*Interfaz para añadir nuevas canciones*@
<form asp-action="Crear" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group mb-2">
        <label asp-for="titulo" class="form-label"></label>
        <input asp-for="titulo" class="form-control" />
        @* Muestra mensaje de validación para el título *@
        <span asp-validation-for="titulo" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="artista" class="form-label"></label>
        <input asp-for="artista" class="form-control" />
        @* Muestra mensaje de validación para el artista *@
        <span asp-validation-for="artista" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="album" class="form-label"></label>
        <input asp-for="album" class="form-control" />
        <span asp-validation-for="album" class="text-danger"></span>
        @* Muestra mensaje de validación para el álbum *@
    </div>

    <div class="form-group mb-2">
        <label asp-for="lanzamiento" class="form-label"></label>
        <input asp-for="lanzamiento" class="form-control" type="date" />
        @* Muestra mensaje de validación para la fecha de lanzamiento *@
        <span asp-validation-for="lanzamiento" class="text-danger"></span>
    </div>
    @* Seleccionador de genero utilizando el enum Genero*@
    <div class="form-group mb-3">
        <label asp-for="genero" class="form-label"></label>
        <select asp-for="genero" class="form-select">
            @* Muestra las opciones de género *@
            @foreach (var g in Enum.GetValues(typeof(Genero)))
            {
                <option value="@g">@g</option>
            }
        </select>
        @* Muestra mensaje de validación para el género *@
        <span asp-validation-for="genero" class="text-danger"></span>
    </div>
    @* Botones de añadir  y volver a la lista*@
    <button type="submit" class="btn btn-success">Añadir</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Volver</a>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
