<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MusicRepository</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MusicRepository.styles.css" asp-append-version="true" />
    <link rel="icon" href="~/MusicRepository2.ico" /> @* Icono de la aplicación*@
</head>
<body>
    <header>
        @*NavBar editado para incluir icono en header*@
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light site-header border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Music" asp-action="Index">
                    <img src='@Url.Content("~/images/MusicRepository2.png")' alt="Logo" width="40" height="30" class="d-inline-block align-text-top me-2" />
                    <span class="fuentetitulo">MusicRepository</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            <span class="fuentetitulo"> @@2026 - MusicRepository</span>
            <img src='@Url.Content("~/images/MusicRepository2.png")' alt="Logo" width="40" height="30" class="d-inline-block align-text-top me-2" />
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
